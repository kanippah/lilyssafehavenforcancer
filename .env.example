# --- Required ---
# PostgreSQL connection string (in Coolify: use the internal URL of your Postgres resource)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lilys?schema=public"

# Secret used to sign auth tokens. Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://lilyssafehavenforcancer.com"

# --- First-boot admin account (created automatically if no admin exists) ---
ADMIN_EMAIL="admin@lilyssafehavenforcancer.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Lily Admin"

# --- Seeding ---
# Set to "false" to skip creating the sample catalog on first boot
SEED_SAMPLE_DATA="true"

# --- Uploads ---
# Admin-uploaded images are stored in PostgreSQL, so there is nothing to
# configure and no volume to mount — they are backed up with the database.

# --- Payments (optional — checkout falls back to "test payment" mode without these) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email (optional — order confirmations + password resets are skipped without SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Lily's Safe Haven <care@lilyssafehavenforcancer.com>"
